# Names and placeholders only: never a real value. Copy to .env for local runs.
PORT=8086
BOOKING_API_URL=http://localhost:8083/api/v1/booking
# The state of the sagas (ADR-065): the login of the service, a member of workflow_writer.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/csp
SPRING_DATASOURCE_USERNAME=workflow_app
SPRING_DATASOURCE_PASSWORD=
# The migration executor of the domain (docker compose --profile tooling run --rm workflow-db-migrate).
WORKFLOW_DB_USER=workflow_migrator
WORKFLOW_DB_PASSWORD=
# Public key of the identity service (one line, \n escapes) - or JWT_PUBLIC_KEY_FILE.
JWT_PUBLIC_KEY=
# Service credential issued by the identity service for csp-workflow - or SERVICE_TOKEN_FILE.
SERVICE_TOKEN=
HTTP_ATTEMPTS=3
HTTP_TIMEOUT_SECONDS=5
HTTP_BACKOFF_MS=200
