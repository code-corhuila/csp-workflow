# Names and placeholders only: never a real value. Copy to .env for local runs.
# These are the variables of deploy/compose.yml, the ones of the platform environment (csp-infra-postgres): each one of this
# domain is named WORKFLOW_*. Compose passes them to the service as PORT, BOOKING_API_URL, SPRING_DATASOURCE_*, JWT_PUBLIC_KEY
# and SERVICE_TOKEN, which are the variables the service itself reads.
PG_DATABASE=csp
PORT=8086
BOOKING_API_URL=http://localhost:8083/api/v1/booking
# The state of the sagas (ADR-065): the login of the service, a member of workflow_writer (SPRING_DATASOURCE_USERNAME).
WORKFLOW_APP_USER=workflow_app
WORKFLOW_APP_PASSWORD=
# The migration executor of the domain (docker compose --profile tooling run --rm workflow-db-migrate).
WORKFLOW_DB_USER=workflow_migrator
WORKFLOW_DB_PASSWORD=
# Public key of the identity service (one line, \n escapes).
JWT_PUBLIC_KEY=
# Service credential issued by the identity service for the subject csp-workflow (SERVICE_TOKEN of the service).
WORKFLOW_SERVICE_TOKEN=
HTTP_ATTEMPTS=3
HTTP_TIMEOUT_SECONDS=5
HTTP_BACKOFF_MS=200
